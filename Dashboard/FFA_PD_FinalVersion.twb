    <worksheet name='One Cluster Stood Alone'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>&lt;Sheet Name&gt;: </run>
            <run>Æ&#10;</run>
            <run fontsize='11'>Fires&apos; Habitual Spread</run>
            <run>Æ&#10;</run>
            <run fontsize='8' italic='true'>Cluster 1 was the only group where measurable fire spread was the typical outcome.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='forestfires_combined (1).csv (Multiple Connections)' name='federated.0hgz35u00i6zbi13uz7sf039i196' />
          </datasources>
          <datasource-dependencies datasource='federated.0hgz35u00i6zbi13uz7sf039i196'>
            <column datatype='real' name='[BUI]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[FFMC]' role='measure' type='quantitative' />
            <column datatype='integer' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[RH]' role='measure' type='quantitative' />
            <column caption='Area' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[area]' role='measure' type='quantitative' />
            <column-instance column='[BUI]' derivation='Avg' name='[avg:BUI:qk]' pivot='key' type='quantitative' />
            <column-instance column='[FFMC]' derivation='Avg' name='[avg:FFMC:qk]' pivot='key' type='quantitative' />
            <column-instance column='[RH]' derivation='Avg' name='[avg:RH:qk]' pivot='key' type='quantitative' />
            <column-instance column='[temp]' derivation='Avg' name='[avg:temp:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Cluster' datatype='integer' name='[cluster]' role='dimension' type='ordinal' />
            <column-instance column='[area]' derivation='Median' name='[med:area:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cluster]' derivation='None' name='[none:cluster:ok]' pivot='key' type='ordinal' />
            <column caption='Temp' datatype='real' default-format='n#,##0.00&quot;°C&quot;;-#,##0.00&quot;°C&quot;' name='[temp]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
