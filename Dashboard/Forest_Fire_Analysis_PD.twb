    <worksheet name='Forest Fires by Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'><![CDATA[<Sheet Name>: August + September Have Most Activity]]></run>
            <run>Æ&#10;</run>
            <run fontsize='8' italic='true'>Late summer weather tends to be hot and dry in the mountainous region of Northeast Portugal. </run>
